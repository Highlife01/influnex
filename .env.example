# ============================================================================
# INFLUNEX ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Never store actual secrets in this file. Use Google Cloud Secret Manager
# or local .env.local for development/staging/production.
# ============================================================================

# 1. Environment & Site Identity
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=https://influnex.com
NEXT_PUBLIC_BRAND_NAME=InfluNex

# 2. Firebase Client SDK (Public Configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# 3. Firebase Admin SDK (Server-Side Only - Secret Manager)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Only this verified Google account receives the server-assigned ADMIN claim.
SUPERADMIN_EMAIL=cebrailkara@gmail.com

# 4. Commercial & Legal Bank Transfer Configuration (Law No. 6493 Compliance)
# Do NOT enable in production until legal commercial model & tax registration are approved.
BANK_TRANSFER_LIVE_ENABLED=false
LEGAL_TERMS_APPROVED=false
COMPANY_LEGAL_TITLE=
COMPANY_BANK_NAME=
COMPANY_BANK_IBAN=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NUMBER=
COMPANY_MERSIS_NO=

# 5. Commission & Financial Rules (Immutable Business Model: 1500 BPS = 15%)
PLATFORM_COMMISSION_BPS=1500
CREATOR_PAYOUT_BPS=8500
DEFAULT_CURRENCY=TRY

# 6. Artificial Intelligence (Server-Side Only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_USER_RATE_LIMIT=20
AI_CACHE_TTL_SECONDS=3600

# 7. SEO, GEO & Search Engine Integrations
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
BING_WEBMASTER_API_KEY=
INDEXNOW_API_KEY=
ALLOW_AI_SEARCH_BOTS=true
ALLOW_AI_TRAINING_BOTS=false

# 8. Analytics & Conversion Tracking
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# 9. Firmanex Partner Integration (OAuth / Signed Webhook)
FIRMANEX_API_BASE_URL=https://api.firmanex.com/v1
FIRMANEX_CLIENT_ID=
FIRMANEX_CLIENT_SECRET=
FIRMANEX_WEBHOOK_SIGNING_SECRET=

# 10. Deployment & Hosting Retention
FIREBASE_HOSTING_SITE=influnex
